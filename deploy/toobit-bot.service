[Unit]
Description=Toobit Multi-Symbol Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toobitbot
Group=toobitbot
WorkingDirectory=/opt/toobit-bot
EnvironmentFile=/etc/toobit-bot.env
ExecStart=/opt/toobit-bot/.venv/bin/python -m app.main --config /opt/toobit-bot/config.json
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/toobit-bot

[Install]
WantedBy=multi-user.target
